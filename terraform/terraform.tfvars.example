# Example Terraform variables file
# Copy this to terraform.tfvars and customize with your values

# Proxmox node name where VMs will be created
target_node           = "your-proxmox-node-name"
clone_template        = "ubuntu-template-24.04-LTS"
clone_template_debian = "debian-template-12"

# VM Resource Configuration
cores   = 4
sockets = 1
vcpus   = 0
memory  = 8192

# Storage Configuration
cloudinit_storage   = "local-lvm"
disk_size           = 32
disk_size_kubespray = 100
disk_cache          = "writeback"
disk_storage        = "local-lvm"
disk_replicate      = true

# Network Configuration
network_model  = "virtio"
network_bridge = "vmbr0"
network_tag    = 50

# IP Configuration - Adjust to match your network
ip_base    = "10.0.50"       # Base IP for your network (e.g., "192.168.1", "10.0.50")
ip_netmask = "24"            # Network mask (typically "24" for /24)
ip_gateway = "10.0.50.1"     # Gateway IP address

# VM IP Address Ranges
control_plane_ip_start = 40  # Starting IP for control plane nodes
worker_ip_start        = 42  # Starting IP for worker nodes

control_plane_ip_start_kubespray = 50  # Starting IP for kubespray control plane
worker_ip_start_kubespray        = 52  # Starting IP for kubespray workers

tags = ["iac"]

# ==============================================================================
# LXC Container Configuration
# ==============================================================================

# LXC Container Settings
lxc_count      = 1
lxc_hostname   = "manager"
lxc_ostemplate = "local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst"
# Set via environment variable: TF_VAR_lxc_password
# lxc_password          = "your_lxc_root_password"
unprivileged = true
nesting      = true

# LXC Network Configuration
lxc_network_bridge = "vmbr0"
lxc_network_ip     = "10.0.50.20/24"  # IP address with subnet mask
lxc_network_ip6    = "dhcp"
lxc_gateway        = "10.0.50.1"
lxc_network_tag    = 50

# LXC Storage Configuration
lxc_rootfs_storage = "local-lvm"
lxc_rootfs_size    = "16G"
lxc_cores          = 2
lxc_memory         = 1024
