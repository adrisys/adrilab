# Example configuration file for pvecli
# Copy this to ~/.pvecli/config.yaml and customize

# Default configuration (used when no profile specified)
host: "https://proxmox.example.com:8006"
token_id: "user@realm!token-name"  
token_secret: "your-secret-here"
verify_ssl: false

# Multiple profiles for different environments
profiles:
  production:
    host: "https://pve-prod.example.com:8006"
    token_id: "admin@pve!prod-cli"
    token_secret: "prod-secret-token"
    verify_ssl: true
    
  lab:
    host: "https://pve-lab.local:8006"
    token_id: "lab@pve!lab-cli"
    token_secret: "lab-secret-token"
    verify_ssl: false
    
  development:
    host: "https://192.168.1.100:8006"
    token_id: "dev@pam!dev-token"
    token_secret: "dev-secret"
    verify_ssl: false
