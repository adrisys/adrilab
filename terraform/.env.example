# Local environment variables for Terraform
# Copy this file to .env.local and fill in your values
# DO NOT commit this file to git

# SSH Key (your actual public key)
export TF_VAR_ssh_public_key=""

# Proxmox API (if needed for local runs)
export PM_API_URL="https://your.domain"
export PM_API_TOKEN_ID="your-token-id"
export PM_API_TOKEN_SECRET="your-token-secret"