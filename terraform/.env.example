# Local environment variables for Terraform
# Copy this file to .env.local and fill in your values
# DO NOT commit this file to git

# S3 Backend Configuration
export TF_CLI_CONFIG_FILE=""
export AWS_REGION=""
export TF_BACKEND_bucket=""
export TF_BACKEND_region=""
export TF_BACKEND_key="terraform/terraform.tfstate"

# SSH Key (your actual public key)
export TF_VAR_ssh_public_key=""

# Cloud-init user configuration
export TF_VAR_ciuser=""
export TF_VAR_cipassword=""

# LXC Container Configuration
export TF_VAR_lxc_password=""

# Proxmox API (if needed for local runs)
export TF_VAR_ciuser=""
export TF_VAR_cipassword=""
export PM_API_URL="https://your.domain"
export PM_API_TOKEN_ID="your-token-id"
export PM_API_TOKEN_SECRET="your-token-secret"